{
  "Database": {
    "SQLitePath": "Data/tracked_vehicle.db"
  },
  "Snowflake": {
    "WorkerId": 1,
    "DataCenterId": 1,
    "Epoch": "2026-01-01T00:00:00Z"
  },
  "NativeSdk": {
    "Enabled": true,
    "LibraryName": "libDemo.so",
    "DefaultDevice": "/dev/video0",
